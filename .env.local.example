# AI Ban Reason Generator Configuration
# 复制此文件为 .env.local 并填入你的配置

# ============================================================================
# AI生成Ban理由功能配置
# ============================================================================

# 是否启用AI生成Ban理由（true/false）
AI_BAN_REASON_ENABLED=false

# Claude API Key
# 获取方式：访问 https://console.anthropic.com/ 注册并获取API Key
AI_BAN_REASON_API_KEY=your_claude_api_key_here

# Claude模型（可选，默认使用 claude-3-5-sonnet-20241022）
# 可选模型：
# - claude-3-5-sonnet-20241022 (推荐，性价比最高)
# - claude-3-opus-20240229 (最强大，但成本较高)
# - claude-3-sonnet-20240229 (旧版本)
AI_BAN_REASON_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# AI生成Pick推荐理由功能配置
# ============================================================================

# 是否启用AI生成Pick推荐理由（true/false）
AI_PICK_REASON_ENABLED=false

# Pick推荐使用相同的API Key和模型配置
# 如需单独配置，可添加：
# AI_PICK_REASON_API_KEY=your_claude_api_key_here
# AI_PICK_REASON_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# 使用说明
# ============================================================================

# 1. 获取Claude API Key
#    - 访问 https://console.anthropic.com/
#    - 注册账号并创建API Key
#    - 复制API Key到上面的 AI_BAN_REASON_API_KEY

# 2. 启用AI生成
#    - 将 AI_BAN_REASON_ENABLED 设置为 true

# 3. 重启开发服务器
#    - 停止当前服务器 (Ctrl+C)
#    - 重新运行 npm run dev

# 4. 在前端调用时传入 useAI: true
#    fetch('/api/lol/ban-scoring', {
#      method: 'POST',
#      body: JSON.stringify({
#        ...otherParams,
#        useAI: true  // 启用AI生成
#      })
#    })

# ============================================================================
# 成本估算
# ============================================================================

# Claude 3.5 Sonnet (推荐)
# - 输入: $3 / 1M tokens
# - 输出: $15 / 1M tokens
# - 每次请求约 500 输入 + 200 输出 tokens
# - 成本: ~$0.0045 per request
# - 1000次请求: ~$4.5

# ============================================================================
# 降级策略
# ============================================================================

# 如果AI调用失败（网络问题、API限额等），系统会自动降级到模板生成
# 确保系统始终能返回有效的Ban理由

# ============================================================================
# 安全注意事项
# ============================================================================

# ⚠️ 不要将 .env.local 文件提交到Git仓库
# ⚠️ 不要在前端代码中暴露API Key
# ⚠️ 建议设置API使用限额，避免意外高额费用
