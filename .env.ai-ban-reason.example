# AI Ban Reason Generator Configuration
# AI驱动的Ban理由生成器配置

# ============================================
# 基础配置
# ============================================

# 是否启用AI生成（true/false）
AI_BAN_REASON_ENABLED=false

# AI服务提供商（anthropic/openai/ollama）
AI_BAN_REASON_PROVIDER=anthropic

# API密钥（必填，Ollama可以填写任意值如"ollama"）
AI_BAN_REASON_API_KEY=your_api_key_here

# AI模型（可选，使用默认值）
# Anthropic: claude-3-5-sonnet-20241022
# OpenAI: gpt-4-turbo-preview
# Ollama: llama3, mistral, qwen2.5, etc.
AI_BAN_REASON_MODEL=

# ============================================
# 高级配置
# ============================================

# 自定义API端点（用于Ollama或其他OpenAI兼容API）
# Ollama默认: http://localhost:11434/v1/chat/completions
AI_BAN_REASON_ENDPOINT=

# 请求超时时间（毫秒）
AI_BAN_REASON_TIMEOUT=10000

# 是否启用缓存
AI_BAN_REASON_CACHE_ENABLED=true

# 缓存过期时间（秒）
AI_BAN_REASON_CACHE_TTL=3600

# 速率限制（每分钟最大请求数）
AI_BAN_REASON_RATE_LIMIT=10

# ============================================
# 降级配置
# ============================================

# AI失败时是否使用模板降级
AI_BAN_REASON_FALLBACK_ENABLED=true

# ============================================
# 使用说明
# ============================================

# 1. 获取API Key:
#    - Anthropic Claude: https://console.anthropic.com/
#    - OpenAI: https://platform.openai.com/

# 2. 将此文件重命名为 .env.local

# 3. 填写你的API Key

# 4. 设置 AI_BAN_REASON_ENABLED=true

# 5. 重启开发服务器

# ============================================
# 成本估算
# ============================================

# Claude API (推荐):
#   - 每次请求约 $0.002
#   - 每月1000次约 $2

# OpenAI API:
#   - 每次请求约 $0.015
#   - 每月1000次约 $15

# ============================================
# 示例配置
# ============================================

# 使用 Anthropic Claude API:
AI_BAN_REASON_ENABLED=true
AI_BAN_REASON_PROVIDER=anthropic
AI_BAN_REASON_API_KEY=sk-ant-api03-Yds...lgAA
AI_BAN_REASON_MODEL=claude-3-5-sonnet-20241022

# 使用 OpenAI API:
# AI_BAN_REASON_ENABLED=true
# AI_BAN_REASON_PROVIDER=openai
# AI_BAN_REASON_API_KEY=sk-xxxxx
# AI_BAN_REASON_MODEL=gpt-4-turbo-preview

# 使用 Ollama 本地开源模型（完全免费）:
# AI_BAN_REASON_ENABLED=true
# AI_BAN_REASON_PROVIDER=ollama
# AI_BAN_REASON_API_KEY=ollama
# AI_BAN_REASON_MODEL=llama3
# AI_BAN_REASON_ENDPOINT=http://localhost:11434/v1/chat/completions
